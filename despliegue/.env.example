# Copiar este archivo como .env (cp .env.example .env) y cambiar las contraseñas.
# El .env no se sube al repositorio.

# Base de datos de la aplicación
BD_NAME=sgrsi
BD_USER=sgrsi_app
BD_PASS=cambiar_esta_clave
# Contraseña del usuario root de MariaDB dentro del contenedor
BD_ROOT_PASS=cambiar_esta_clave_root

# Puerto del servidor donde se publica la web (80 lo usa el Apache instalado en el servidor)
WEB_PUERTO=8080
